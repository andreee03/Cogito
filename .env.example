# Copier ce fichier en .env puis remplir les valeurs.

# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Base de données : SQLite en local. En production, une URL Postgres (Neon).
DATABASE_URL=sqlite:///./shopping.db

# Origines autorisées pour le front-end (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mode développement gratuit : 1 = faux Claude (produits fictifs, 0 $),
# aucune clé API nécessaire. Retirer la ligne (ou mettre 0) pour le vrai Claude.
FAKE_CLAUDE=0

# Import depuis Notion (bouton « Importer de Notion ») : clé d'une intégration
# interne (https://www.notion.so/my-integrations), connectée à la base « Tasks [PT] ».
NOTION_TOKEN=
# Base Notion à lire (par défaut : Tasks [PT] du PARA Dashboard).
# NOTION_DATABASE_ID=d072b32f4429826283d681573e8014db

# Copier ce fichier en .env puis remplir les valeurs.

# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Base de données : SQLite en local. En production, une URL Postgres (Neon).
DATABASE_URL=sqlite:///./shopping.db

# Origines autorisées pour le front-end (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
